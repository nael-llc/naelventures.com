{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naelventures",
  // Assets-only Worker. Do not add a "main" script or "run_worker_first":
  // static asset requests are free and unlimited, and this site has no server code.
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    // Built by `npm run build`. Never point this at the repository root.
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
